@model GovernoratesViewModel
@{ ViewData["Title"] = T["nav_shipping"]; }
<h1 class="h3 mb-1">@T["nav_shipping"]</h1>
<p class="text-muted">@T["shipping_hint"]</p>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0" data-testid="governorates">
            <thead><tr><th>@T["governorate"]</th><th>@T["shipping_fee"] (@T["currency"])</th><th>@T["delivery_available"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in Model.Items)
            {
                var formId = $"gov-form-{g.Id}";
                <tr id="gov-@g.Id" class="@(g.IsActive ? "" : "table-light text-muted")">
                    <td>@(T.IsArabic ? g.NameAr : g.NameEn) <small class="text-muted">@(T.IsArabic ? g.NameEn : g.NameAr)</small></td>
                    <td style="max-width:160px">
                        <input form="@formId" name="ShippingFee" type="number" step="0.01" min="0" value="@g.ShippingFee.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" aria-label="@T["shipping_fee"]" />
                    </td>
                    <td>
                        <div class="form-check form-switch">
                            <input form="@formId" name="IsActive" type="checkbox" value="true" class="form-check-input" checked="@g.IsActive" aria-label="@T["delivery_available"]" />
                            <input form="@formId" name="IsActive" type="hidden" value="false" />
                        </div>
                    </td>
                    <td class="text-end">
                        <form id="@formId" method="post" asp-action="Update" asp-route-id="@g.Id">
                            <button class="btn btn-sm btn-honey">@T["save"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
