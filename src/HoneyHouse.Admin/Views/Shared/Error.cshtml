@{
    var code = ViewData["Code"] as int? ?? 500;
    ViewData["Title"] = T["error_title"];
    Layout = User.Identity?.IsAuthenticated == true && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager)) ? "_Layout" : "_AuthLayout";
}
<div class="text-center py-5">
    <div class="display-4">@code</div>
    <h1 class="h3">@T[code == 404 ? "error_404" : "error_title"]</h1>
    @if (code != 404) { <p class="text-muted">@T["error_text"]</p> }
    <a class="btn btn-honey" asp-controller="Dashboard" asp-action="Index">@T["back_home"]</a>
</div>
