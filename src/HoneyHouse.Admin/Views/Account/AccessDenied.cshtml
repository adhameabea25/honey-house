@{
    ViewData["Title"] = T["access_denied_title"];
    Layout = User.Identity?.IsAuthenticated == true && (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager)) ? "_Layout" : "_AuthLayout";
}
<div class="text-center py-5">
    <div class="display-4">🔒</div>
    <h1 class="h3">@T["access_denied_title"]</h1>
    <p class="text-muted">@T["access_denied_text"]</p>
    <a class="btn btn-honey" asp-controller="Dashboard" asp-action="Index">@T["back_home"]</a>
</div>
