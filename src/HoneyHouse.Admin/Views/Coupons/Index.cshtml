@model CouponListViewModel
@{ ViewData["Title"] = T["nav_coupons"]; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">@T["nav_coupons"]</h1>
    <a asp-action="Create" class="btn btn-honey">+ @T["coupon_add"]</a>
</div>
<form method="get" class="card card-body shadow-sm mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small" for="search">@T["search"]</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" dir="ltr" placeholder="RAMADAN" />
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="isActive">@T["status"]</label>
            <select id="isActive" name="isActive" class="form-select">
                <option value="">@T["all"]</option>
                <option value="true" selected="@(Model.IsActive == true)">@T["active"]</option>
                <option value="false" selected="@(Model.IsActive == false)">@T["inactive"]</option>
            </select>
        </div>
        <div class="col-md-5 d-flex gap-2">
            <button class="btn btn-dark" type="submit">@T["filter"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@T["reset"]</a>
        </div>
    </div>
</form>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0" data-testid="coupons">
            <thead><tr><th>@T["coupon_code"]</th><th>@T["discount"]</th><th>@T["conditions"]</th><th>@T["validity"]</th><th>@T["usage"]</th><th>@T["status"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Result.Items)
            {
                var expired = c.ExpiresAt is { } e && e <= Model.NowUtc;
                var notStarted = c.StartsAt is { } s && s > Model.NowUtc;
                <tr>
                    <td><span class="fw-bold ltr">@c.Code</span><div class="small text-muted">@(T.IsArabic ? c.DescriptionAr : c.DescriptionEn)</div></td>
                    <td class="text-nowrap">@(c.DiscountType == DiscountType.Percentage ? $"{Fmt.Number(c.Value)}%" : Fmt.Money(c.Value, T))</td>
                    <td class="small">
                        @if (c.MinOrderAmount is { } min) { <div>@T["min_order"]: @Fmt.Money(min, T)</div> }
                        @if (c.MaxDiscountAmount is { } max) { <div>@T["max_discount"]: @Fmt.Money(max, T)</div> }
                    </td>
                    <td class="small ltr text-nowrap">@(c.StartsAt is { } st ? Fmt.Date(st) : "…") → @(c.ExpiresAt is { } ex ? Fmt.Date(ex) : "…")</td>
                    <td>@c.UsedCount@(c.UsageLimit is { } l ? $" / {l}" : "")</td>
                    <td>
                        @if (!c.IsActive) { <span class="badge bg-secondary">@T["inactive"]</span> }
                        else if (expired) { <span class="badge bg-danger">@T["coupon_expired_badge"]</span> }
                        else if (notStarted) { <span class="badge bg-info text-dark">@T["coupon_scheduled"]</span> }
                        else { <span class="badge bg-success">@T["active"]</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">@T["edit"]</a>
                        @if (c.UsedCount == 0)
                        {
                            <form method="post" asp-action="Delete" asp-route-id="@c.Id" class="d-inline" data-confirm="@T["confirm_delete"]">
                                <button class="btn btn-sm btn-outline-danger">@T["delete"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted">@T["no_results"]</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Pager.From(Model.Result)" />
</div>
