@model ProductForm
@{ ViewData["Title"] = T["product_add"]; }
<h1 class="h3 mb-3">@T["product_add"]</h1>
<form method="post" asp-action="Create" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">@T["product_info"]</div>
        <div class="card-body"><partial name="_ProductFields" model="Model" /></div>
    </div>
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold">@T["first_variant"]</div>
        <div class="card-body">
            <p class="small text-muted">@T["first_variant_hint"]</p>
            <partial name="_VariantFields" for="Variant" />
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-honey">@T["save"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["cancel"]</a>
    </div>
</form>
