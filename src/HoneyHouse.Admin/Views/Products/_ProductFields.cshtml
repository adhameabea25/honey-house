@model ProductForm
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="NameAr" class="form-label">@T["name_ar"] *</label>
        <input asp-for="NameAr" class="form-control" dir="rtl" />
        <span asp-validation-for="NameAr" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NameEn" class="form-label">@T["name_en"] *</label>
        <input asp-for="NameEn" class="form-control" dir="ltr" />
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DescriptionAr" class="form-label">@T["description_ar"]</label>
        <textarea asp-for="DescriptionAr" class="form-control" rows="4" dir="rtl"></textarea>
        <span asp-validation-for="DescriptionAr" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DescriptionEn" class="form-label">@T["description_en"]</label>
        <textarea asp-for="DescriptionEn" class="form-control" rows="4" dir="ltr"></textarea>
        <span asp-validation-for="DescriptionEn" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label">@T["category"] *</label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="0">—</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Origin" class="form-label">@T["origin"]</label>
        <input asp-for="Origin" class="form-control" placeholder="@T["origin_hint"]" />
        <span asp-validation-for="Origin" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label">@T["slug"]</label>
        <input asp-for="Slug" class="form-control" dir="ltr" placeholder="@T["slug_hint"]" />
        <span asp-validation-for="Slug" class="text-danger small"></span>
    </div>
    <div class="col-12 d-flex gap-4">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@T["product_visible"]</label>
        </div>
        <div class="form-check">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label">@T["featured"]</label>
        </div>
    </div>
</div>
