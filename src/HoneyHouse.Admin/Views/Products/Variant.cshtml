@model VariantForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = T[isNew ? "variant_add" : "variant_edit"];
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["nav_products"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Edit" asp-route-id="@Model.ProductId">@Model.ProductName</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>
</nav>
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form method="post" asp-action="@(isNew ? "AddVariant" : "EditVariant")" asp-route-id="@Model.ProductId" asp-route-variantId="@(isNew ? null : Model.Id)" class="card shadow-sm" novalidate>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <partial name="_VariantFields" model="Model" />
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <button type="submit" class="btn btn-honey">@T["save"]</button>
        <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-outline-secondary">@T["cancel"]</a>
    </div>
</form>
