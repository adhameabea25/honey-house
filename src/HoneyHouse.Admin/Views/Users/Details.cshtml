@model UserDetailsViewModel
@{
    var u = Model.User;
    ViewData["Title"] = u.FullName;
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">@T["nav_users"]</a></li>
        <li class="breadcrumb-item active">@u.FullName</li>
    </ol>
</nav>
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4">@u.FullName</h1>
                <div class="ltr">@u.Email</div>
                <div class="ltr">@u.PhoneNumber</div>
                <div class="mt-2 small text-muted">@T["joined"]: <span class="ltr">@Fmt.Date(u.CreatedAt)</span> · @T["preferred_language"]: @(u.PreferredLanguage == "en" ? "English" : "العربية")</div>
                <div class="mt-2">
                    <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")" data-testid="user-status">@T[u.IsActive ? "active" : "user_disabled_badge"]</span>
                    @if (u.IsLockedOut) { <span class="badge bg-danger">@T["locked"]</span> }
                </div>
                @if (u.Roles.Contains(Roles.Customer))
                {
                    <a asp-controller="Orders" asp-action="Index" asp-route-search="@u.Email" class="btn btn-sm btn-outline-dark mt-3">@T["customer_orders"]</a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <form method="post" asp-action="Roles" asp-route-id="@u.Id" class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold">@T["roles"]</div>
            <div class="card-body">
                @foreach (var r in Roles.All)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="roles" value="@r" id="role-@r" checked="@u.Roles.Contains(r)" />
                        <label class="form-check-label" for="role-@r">@T[$"role_{r}"] <small class="text-muted">— @T[$"role_hint_{r}"]</small></label>
                    </div>
                }
                @if (Model.IsSelf) { <div class="form-text">@T["cannot_modify_self"]</div> }
            </div>
            <div class="card-footer bg-white"><button class="btn btn-honey">@T["save"]</button></div>
        </form>
        @if (!Model.IsSelf)
        {
            <form method="post" asp-action="Status" asp-route-id="@u.Id" class="card shadow-sm" data-confirm="@T[u.IsActive ? "confirm_disable_user" : "confirm_enable_user"]">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span>@T[u.IsActive ? "disable_user_hint" : "enable_user_hint"]</span>
                    <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                    <button class="btn @(u.IsActive ? "btn-outline-danger" : "btn-success")">@T[u.IsActive ? "disable_user" : "enable_user"]</button>
                </div>
            </form>
        }
    </div>
</div>
