{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Admin": {
    "SessionHours": 8
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "RequestPath": "/uploads"
  },
  "Seed": {
    "RunOnStartup": true,
    "ApplyMigrations": true,
    "SampleData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
